{$STARDUST_DOMAIN} {
	encode gzip
	# Admin endpoints stay reachable only from the server itself (ssh in and use curl on localhost:8080
	# via `docker compose exec core ...`), never from the internet.
	@admin path /v1/admin/*
	respond @admin 404
	# Data Center Resource Ledger (docs/architecture/ledger.md). handle_path strips /ledger, so the
	# service sees /v1/...; its admin endpoints are blocked inside the block (respond runs before
	# reverse_proxy), just like Core's.
	handle_path /ledger/* {
		@ledger_admin path /v1/admin /v1/admin/*
		respond @ledger_admin 404
		reverse_proxy ledger:8090
	}
	request_body {
		max_size 10MB
	}
	reverse_proxy core:8080
}
