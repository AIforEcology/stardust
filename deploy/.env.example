# Copy to deploy/.env on the server. Never commit .env.
STARDUST_DOMAIN=core.aifore.org

# Long random string: `openssl rand -hex 32`. Needed for provider vetting and key management.
STARDUST_ADMIN_TOKEN=change-me

# Public hosting: every client uses a key. Extension installs get one from POST /v1/installs.
STARDUST_INGEST_AUTH=required
STARDUST_SUBSCRIBER_AUTH=required
STARDUST_SELF_REGISTRATION=on
STARDUST_REGISTRATIONS_PER_IP_PER_HOUR=20

# Refresh model prices daily; keep events for two years (§14.1).
STARDUST_PRICING_REFRESH=24
STARDUST_RETENTION_DAYS=730
