{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIforEcology/stardust/schema/provider-telemetry.schema.json",
  "title": "Carbon capture provider telemetry record",
  "description": "Raw telemetry reported by a carbon capture provider (§20.2–§20.5). Keys are the spec's 3-letter field codes. Derived D- fields (§20.6) are computed by Stardust and stored separately, never accepted from providers.",
  "type": "object",
  "required": ["FPI", "tech_type", "timestamp", "DST"],
  "additionalProperties": false,
  "properties": {
    "FPI": { "type": "string", "description": "Facility/Project ID." },
    "tech_type": { "enum": ["DAC", "PSC", "NBC", "OBC"], "description": "Capture technology (§20.1)." },
    "timestamp": { "type": "string", "format": "date-time" },

    "CRI": { "type": "number", "minimum": 0, "description": "Capture Rate Interval, kg/hr." },
    "CEP": { "type": "number", "minimum": 0, "maximum": 100, "description": "Capture Efficiency Percentage." },
    "CUR": { "type": "number", "minimum": 0, "maximum": 100, "description": "Capacity Utilization Rate, %." },
    "UDL": {
      "type": "object",
      "description": "Uptime/Downtime Log.",
      "properties": {
        "uptime_hrs": { "type": "number", "minimum": 0 },
        "downtime_hrs": { "type": "number", "minimum": 0 },
        "reason_code": { "type": ["string", "null"] }
      }
    },

    "CCM": { "type": "number", "minimum": 0, "description": "Cumulative Captured Mass, kg, per crediting period." },
    "SUP": { "enum": ["geologic", "mineralization", "utilization", "transport"], "description": "Storage/Utilization Pathway." },
    "CSP": { "type": "number", "minimum": 0, "maximum": 100, "description": "CO2 Stream Purity, %." },
    "PLR": { "type": "number", "minimum": 0, "description": "Post-Capture Leakage Rate, %." },

    "ECT": { "type": "number", "minimum": 0, "description": "Energy Consumption per Tonne, kWh/t." },
    "ESM": {
      "type": "object",
      "description": "Energy Source Mix, % split keyed by grid | renewable | onsite.",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "WCT": { "type": "number", "minimum": 0, "description": "Water Consumption per Tonne, L/t." },
    "SCR": { "type": "number", "minimum": 0, "description": "Sorbent/Solvent Consumption Rate, kg/t." },
    "RCC": { "type": "integer", "minimum": 0, "description": "Regeneration Cycle Count." },

    "SCT": {
      "type": "object",
      "description": "Sensor Calibration Timestamp.",
      "properties": {
        "calibrated_at": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    },
    "DST": { "enum": ["direct_metered", "estimated", "modeled"], "description": "Data Source Type." },
    "MSR": { "type": "string", "description": "MRV Standard Reference, e.g. puro_earth, verra, isometric." },
    "GLC": {
      "type": "object",
      "description": "Geolocation Coordinate.",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "RFI": { "enum": ["realtime", "hourly", "daily", "weekly", "monthly"], "description": "Reporting Frequency Interval." }
  }
}
