{
  "manifest_version": 3,
  "name": "Stardust (AIforE Subscriber Plugin)",
  "short_name": "Stardust",
  "version": "0.1.0",
  "description": "See the cost, energy, carbon and water behind your AI chats. An open-source AI for Ecology project.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Stardust" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
