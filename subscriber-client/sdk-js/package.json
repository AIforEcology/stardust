{
  "name": "@aifore/stardust",
  "version": "0.2.0",
  "description": "Stardust SDK by AIforE: meter Anthropic, OpenAI and Gemini API usage (measured tokens), see its cost, energy, CO2e and water, and request remediation, via Stardust Core.",
  "license": "Apache-2.0",
  "author": "AI for Ecology (AIforE)",
  "homepage": "https://aifore.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIforEcology/stardust.git",
    "directory": "subscriber-client/sdk-js"
  },
  "bugs": {
    "url": "https://github.com/AIforEcology/stardust/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "carbon",
    "sustainability",
    "metering",
    "opentelemetry",
    "anthropic",
    "openai",
    "gemini"
  ],
  "stardust": {
    "specVersion": "1.7"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.6",
    "openai": "^7.57.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
