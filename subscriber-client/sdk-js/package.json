{
  "name": "@stardust/sdk",
  "version": "0.1.0",
  "description": "Stardust infra SDK: meter Anthropic, OpenAI and Gemini API usage (measured tokens) and report it to Stardust Core.",
  "license": "Apache-2.0",
  "stardust": {
    "specVersion": "1.6"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^22.0.0",
    "openai": "^7.36.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
